# ---------------------------------------------------------------
# Everything listed here is kept OUT of the image.
#
# The first line is the important one. Without it, `COPY` would bake
# your keys into a layer, and anyone who pulls the image can read it
# back out with `docker history`. A key in an image is a published key.
# ---------------------------------------------------------------
.env
.env.*
!.env.example

# the local Python environment - the image builds its own
.venv/
__pycache__/
**/__pycache__/
*.pyc

# the conversation file from running locally. The container makes
# its own empty one; shipping yours would hand every user your chats.
data/

# not needed at runtime
docs/
.git/
.gitignore
.DS_Store
README.md
