# ===============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ===============================================================

# ---- 1. One OpenRouter key does everything --------------------
# Get it from https://openrouter.ai/keys
# It pays for BOTH the chat models and the embeddings.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ---- 2. The database (Supabase) -------------------------------
# Make a free project at https://supabase.com - no card needed.
# Then, in that order:
#   1. SQL Editor -> New query -> paste all of scripts/schema.sql -> Run
#   2. fill in the two values below
#   3. python scripts/seed.py
# Both values are on the Project Overview page: the Copy button beside
# the project name (or the green Connect button).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-api-key

# ---- 3. Langfuse: records what the agent did ------------------
# Free account at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- 4. Optional ----------------------------------------------
# Live web search. Leave blank - the agent handles it being missing.
TAVILY_API_KEY=

# ---- 5. Which models to use (defaults are fine) ---------------
# These are OpenRouter names, so they need the "anthropic/" prefix.
ANSWER_MODEL=anthropic/claude-sonnet-4.6
ROUTER_MODEL=anthropic/claude-haiku-4.5
JUDGE_MODEL=anthropic/claude-haiku-4.5
EMBED_MODEL=openai/text-embedding-3-small
